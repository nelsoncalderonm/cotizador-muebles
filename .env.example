# Link de pago de la suscripción (checkout de Hotmart). Si está vacío, el botón lleva a la demo /app.
NEXT_PUBLIC_CHECKOUT_URL=
# Precio que muestra la landing
NEXT_PUBLIC_PRECIO=US$10
# Transcripción de notas de voz (OpenAI). Sin esta clave, el dictado por voz no funciona (escribir sí).
OPENAI_API_KEY=
# Opcional: modelo de transcripción (por defecto gpt-4o-mini-transcribe; también sirve whisper-1)
OPENAI_TRANSCRIBE_MODEL=
