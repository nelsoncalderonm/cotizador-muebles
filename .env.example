# Link de pago de la suscripción (checkout de Hotmart). Si está vacío se usa el del plan mensual.
NEXT_PUBLIC_CHECKOUT_URL=https://pay.hotmart.com/M108507757C
# Precio que muestra la landing
NEXT_PUBLIC_PRECIO=US$15
# Transcripción de notas de voz. Basta una de las dos claves; sin ninguna, el dictado no funciona (escribir sí).
# OpenRouter: usa un modelo que recibe audio (por defecto google/gemini-2.5-flash; se cambia con OPENROUTER_AUDIO_MODEL).
OPENROUTER_API_KEY=
OPENROUTER_AUDIO_MODEL=
# OpenAI (Whisper / gpt-4o-mini-transcribe). Si está, tiene prioridad.
OPENAI_API_KEY=
# Opcional: modelo de transcripción (por defecto gpt-4o-mini-transcribe; también sirve whisper-1)
OPENAI_TRANSCRIBE_MODEL=
